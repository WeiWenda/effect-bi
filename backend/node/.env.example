# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL (mock-table, migrations, lineage API). Stack pgvector from host (example):
# PG_HOST=127.0.0.1
# PG_PORT=5434
# PG_DATABASE=lineage
# PG_USER=stack
# PG_PASSWORD=stacksecret
# Demo tables from `npm run mock-table` live in schema **demo**, not public.

# Cube Home Directory (for writing model_yml and view_yml files on publish)
CUBE_HOME=/path/to/cube-home

# ETL: Airflow DAG .py on publish (optional; if unset, publish generates source but skips disk write)
# ETL_AIRFLOW_DAGS_DIR=/path/to/airflow/dags
# AIRFLOW_HOME=/path/to/airflow
# Airflow REST（可选）：ETL 发布成功后会 PATCH 取消暂停 DAG，开启调度（默认 Airflow 3 /api/v2）
# AIRFLOW_REST_BASE_URL=http://127.0.0.1:8080
# 发布后先 GET 轮询直到 DAG 出现在 REST（默认最多 120s，每 3s）
# ETL_AIRFLOW_DAG_VISIBLE_WAIT_MS=120000
# ETL_AIRFLOW_DAG_VISIBLE_POLL_MS=3000
# ETL_AIRFLOW_SKIP_DAG_VISIBLE_WAIT=0
# Airflow 3：会自动 POST /auth/token 换 JWT（Bearer）；请勿再用 Basic
# AIRFLOW_REST_USERNAME=airflow
# AIRFLOW_REST_PASSWORD=airflow
# 或直接贴 JWT（跳过登录）：AIRFLOW_REST_TOKEN=eyJ...
# Airflow 2：AIRFLOW_REST_API_VERSION=v1（仍用上面的账号密码做 Basic）
# 发布后 Backfill（仅 Airflow 3 v2）：调度开始日～当前时间内未完成区间；none|failed|completed
# ETL_AIRFLOW_BACKFILL_REPROCESS=failed
# 单次回填内并行 DAG Run 上限（写入 Airflow POST /api/v2/backfills）；须写在 backend/.env 并重启后端
# ETL_AIRFLOW_BACKFILL_MAX_ACTIVE_RUNS=16
# Trino for Ad-hoc + dry-run (optional; if unset, uses mock rows)
# TRINO_URL=http://localhost:8080
# TRINO_USER=etl-effect-bi
# TRINO_CATALOG=hive
# TRINO_SCHEMA=default
# TRINO_MAX_ROWS=500
# TRINO_CLIENT_TIMEOUT_MS=120000

# ETL Airflow callbacks + dependency checks
# DEFAULT_ETL_CATALOG=hive
# ETL_ALERT_DISPATCH_SECRET=change-me  # Bearer token for POST /api/etl/alerts/dispatch-tick

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
