# Server Configuration
PORT=3001
NODE_ENV=development

# Cube Home Directory (for writing model_yml and view_yml files on publish)
CUBE_HOME=/path/to/cube-home

# ETL: Airflow DAG files on publish (optional; if unset, publish updates DB only)
# ETL_AIRFLOW_DAGS_DIR=/path/to/airflow/dags
# AIRFLOW_HOME=/path/to/airflow
# FastAPI DAG generator (Task SDK–style source). Fallback: Node template if unreachable.
# ETL_DAG_PY_SERVICE_URL=http://127.0.0.1:8790
# ETL_DAG_PY_SERVICE_TIMEOUT_MS=30000
# Trino for Ad-hoc + dry-run (optional; if unset, uses mock rows)
# TRINO_URL=http://localhost:8080
# TRINO_USER=etl-chatbot
# TRINO_CATALOG=hive
# TRINO_SCHEMA=default
# TRINO_MAX_ROWS=500
# TRINO_CLIENT_TIMEOUT_MS=120000

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
