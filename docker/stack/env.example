# Copy to docker/stack/.env and adjust (never commit .env).
# Used by: docker compose -f docker-compose.stack.yaml

# --- Airflow (Apache compose; Fernet must be stable across restarts) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_FERNET_KEY_44_CHARS_URLSAFE_BASE64
AIRFLOW_UID=50000
AIRFLOW__API_AUTH__JWT_SECRET=change_me_airflow_jwt
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Shared Postgres (pgvector) for LangGraph + Node lineage + Cube warehouse ---
STACK_POSTGRES_PASSWORD=stacksecret
# Same image for `pgvector` and `effect-bi-init` (avoids a second client image). Optional mirror, e.g.:
# PGVECTOR_IMAGE=registry.example.com/pgvector/pgvector:pg16

# --- Neo4j ---
NEO4J_PASSWORD=stacksecret

# --- LangGraph (required by docker-entrypoint) ---
JWT_SECRET_KEY=change_me_jwt_langgraph
OPENAI_API_KEY=sk-replace-me
LANGGRAPH_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
LANGFUSE_TRACING_ENABLED=false

# --- effect-bi web (docker-compose.stack service `effect-bi`) ---
# EFFECT_BI_PUBLISH_PORT=3001

# --- Gravitino bootstrap (`gravitino-init`; REST http://gravitino:8090/api — JDBC catalog → pgvector / lineage) ---
# If pulling alpine fails: ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
# GRAVITINO_METALAKE=effectbi
# GRAVITINO_PG_CATALOG=localpg

# --- Vite / effect-bi image build (must match metalake name; rebuild effect-bi after change) ---
# VITE_GRAVITINO_METALAKE=effectbi

# --- Cube ---
CUBEJS_API_SECRET=devcubeapisecret
# Host folder → effect-bi /cube-home + Cube /cube/conf (published cubes/views YML). Default in compose: ./docker/stack/cube-home
# CUBE_HOST_DIR=./docker/stack/cube-home

# --- Trino (optional overrides; compose maps coordinator to host :8088 by default) ---
# CATALOG_MANAGEMENT defaults to dynamic in compose (Gravitino); set static if you need file-only catalogs
# TRINO_HOST_DIR=./docker/stack/trino   # host path with etc/catalog + plugin/gravitino
# TRINO_IMAGE=trinodb/trino:453
# TRINO_PUBLISH_PORT=8088
# TRINO_USER=etl-effect-bi
# TRINO_CATALOG=gravitino
# TRINO_SCHEMA=
# Plugin jars (downloads Apache tarball): bash docker/stack/trino/sync-plugin-from-dev.sh
# GRAVITINO_TRINO_CONNECTOR_URL=...   # optional mirror URL

# Optional mirrors (Dockerfile build-args). If LangGraph build fails with apt
# "502 Bad Gateway" / timeouts from deb.debian.org, uncomment one (hostname only):
# APT_MIRROR_HOST=mirrors.aliyun.com
# APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
# NODE_IMAGE=node:22-bookworm-slim
# PYTHON_IMAGE=python:3.13-slim-bookworm
