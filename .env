# Gravitino Configuration (align with docker/stack gravitino-init metalake name; stack default effectbi)
VITE_GRAVITINO_METALAKE=effectbi

VITE_META_ONLY=true


# 仅元数据管理：true 时隐藏 ETL、Cube、可视化查询、看板（保留 Table Meta / 链路治理 / Chat）
# VITE_META_ONLY=true

# 链路治理 → 任务开发：节点 Airflow 链接（默认本地 Airflow UI）
# VITE_AIRFLOW_UI_BASE_URL=http://localhost:8080

# Vite 开发代理：LangGraph（backend/langgraph）默认 http://127.0.0.1:8001；npm run dev:all 会按 LANGGRAPH_PORT 注入
# VITE_LANGGRAPH_PROXY_TARGET=http://127.0.0.1:8001
